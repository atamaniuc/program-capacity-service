{
  "name": "@finverity/funding",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "dependencies": {
    "@finverity/contracts": "*",
    "@bufbuild/protobuf": "2.16.0",
    "@grpc/grpc-js": "1.14.6",
    "kysely": "0.29.7",
    "pg": "8.23.1",
    "prom-client": "15.1.3",
    "jose": "6.2.13",
    "zod": "4.6.7",
    "zod-openapi": "6.0.2",
    "yaml": "2.9.1"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project int",
    "contracts": "tsx tools/contracts.ts",
    "contracts:check": "tsx tools/contracts.ts --check",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp -R src/funding/adapters/out/postgres/migrations dist/funding/adapters/out/postgres/",
    "start": "node dist/main.js"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@testcontainers/toxiproxy": "12.2.1",
    "@types/pg": "8.23.1",
    "@types/node": "24.19.2",
    "testcontainers": "12.2.1"
  }
}
