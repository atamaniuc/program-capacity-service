# Placeholders only. Copy to .env for local runs; never commit real values.
APP_ROLE=all
HTTP_PORT=3000
OPS_PORT=9464
DATABASE_URL=postgres://capacity:capacity@localhost:5432/capacity
KAFKA_BROKERS=localhost:9092
OAUTH_ISSUER=http://localhost:8081/default
OAUTH_AUDIENCE=capacity-service
OAUTH_JWKS_URL=http://localhost:8081/default/jwks
# Local only: lets Swagger UI at http://localhost:9464/docs log in and call the API.
OAUTH_TOKEN_URL=http://localhost:8081/default/token
CORS_ORIGINS=http://localhost:9464,http://127.0.0.1:9464
FX_MAX_AGE=24h
RECON_TOLERANCE_MINOR=1
RECON_MAX_RESERVATIONS=50000
RECON_MODE=HOLD
LOG_LEVEL=info
