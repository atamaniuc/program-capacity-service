# Placeholders only. Copy to .env for local runs; never commit real values.
APP_ROLE=all
# Branch `microservices` (ADR 027): host ports are main's +10000. The Makefile, compose.yaml,
# tools/ and db/seeds read these HOST_PORT_* variables; the defaults below are the same numbers.
HOST_PORT_POSTGRES=15432
HOST_PORT_KAFKA=39092
HOST_PORT_OAUTH=18081
HOST_PORT_API=13000
HOST_PORT_API_OPS=19464
HOST_PORT_WORKER_OPS=19465
HTTP_PORT=13000
OPS_PORT=19464
DATABASE_URL=postgres://capacity:capacity@localhost:15432/capacity
KAFKA_BROKERS=localhost:9092
OAUTH_ISSUER=http://localhost:18081/default
OAUTH_AUDIENCE=capacity-service
OAUTH_JWKS_URL=http://localhost:18081/default/jwks
# Local only: lets Swagger UI at http://localhost:19464/docs log in and call the API.
OAUTH_TOKEN_URL=http://localhost:18081/default/token
CORS_ORIGINS=http://localhost:19464,http://127.0.0.1:19464
FX_MAX_AGE=24h
RECON_TOLERANCE_MINOR=1
RECON_MAX_RESERVATIONS=50000
RECON_MODE=HOLD
LOG_LEVEL=info
