{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProgramReconciled",
  "type": "object",
  "properties": {
    "messageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "tenantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "programId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "type": {
      "type": "string",
      "const": "ProgramReconciled"
    },
    "payload": {
      "type": "object",
      "properties": {
        "asOf": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "creditLimit": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string"
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          },
          "required": [
            "value",
            "currency"
          ]
        },
        "platformWatermark": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reservations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "invoiceId": {
                "type": "string",
                "minLength": 1
              },
              "outstandingInvoiceAmount": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string"
                  },
                  "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                  }
                },
                "required": [
                  "value",
                  "currency"
                ]
              },
              "outstandingReservedAmount": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string"
                  },
                  "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                  }
                },
                "required": [
                  "value",
                  "currency"
                ]
              }
            },
            "required": [
              "invoiceId",
              "outstandingInvoiceAmount",
              "outstandingReservedAmount"
            ]
          }
        }
      },
      "required": [
        "asOf",
        "creditLimit",
        "reservations"
      ]
    }
  },
  "required": [
    "messageId",
    "schemaVersion",
    "tenantId",
    "programId",
    "seq",
    "occurredAt",
    "type",
    "payload"
  ]
}
