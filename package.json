{
  "name": "program-capacity-service",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": "github:atamaniuc/program-capacity-service",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp -R src/capacity/adapters/out/postgres/migrations dist/capacity/adapters/out/postgres/",
    "start": "tsx src/main.ts",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "typecheck": "tsc --noEmit",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "test": "npm run test:unit && npm run test:int",
    "test:unit": "vitest run --project unit --coverage",
    "test:int": "vitest run --project int",
    "migrate": "tsx src/capacity/adapters/out/postgres/migrate.ts",
    "seed": "tsx db/seeds/seed.ts",
    "token": "tsx tools/token/token.ts",
    "demo": "tsx tools/demo/demo.ts",
    "contracts": "tsx tools/contracts/generate.ts",
    "contracts:check": "tsx tools/contracts/generate.ts --check",
    "dlq-replay": "tsx tools/dlq-replay/replay.ts",
    "simulate": "tsx tools/simulator/cli.ts",
    "load": "docker run --rm -i -v \"$PWD/tools/load:/load\" -e HOST_PORT_API=${HOST_PORT_API:-13000} -e HOST_PORT_OAUTH=${HOST_PORT_OAUTH:-18081} grafana/k6 run --summary-export=/load/summary.json /load/scenario.js"
  },
  "dependencies": {
    "@confluentinc/kafka-javascript": "1.11.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/instrumentation-express": "0.72.0",
    "@opentelemetry/instrumentation-http": "0.300.0",
    "@opentelemetry/instrumentation-pg": "0.77.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "jose": "6.2.13",
    "kysely": "0.29.7",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "swagger-ui-dist": "5.34.0",
    "yaml": "2.9.1",
    "zod": "4.6.7",
    "zod-openapi": "6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@swc/core": "1.16.20",
    "@testcontainers/kafka": "12.2.1",
    "@testcontainers/postgresql": "12.2.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "harnessimo": "^0.10.1",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  },
  "scarfSettings": {
    "enabled": false
  }
}
