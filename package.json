{
  "name": "program-capacity-service",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": "github:atamaniuc/program-capacity-service",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp -R src/capacity/adapters/out/postgres/migrations dist/capacity/adapters/out/postgres/",
    "start": "tsx src/main.ts",
    "lint": "git ls-files -z -- '*.js' '*.cjs' '*.mjs' '*.ts' '*.cts' '*.mts' | xargs -0 eslint --max-warnings 0 --no-warn-ignored && git ls-files -z | xargs -0 prettier --check --ignore-unknown",
    "typecheck": "tsc --noEmit",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "test": "npm run test:unit && npm run test:int",
    "test:unit": "vitest run --project unit --coverage",
    "test:int": "vitest run --project int",
    "migrate": "tsx src/capacity/adapters/out/postgres/migrate.ts",
    "seed": "tsx db/seeds/seed.ts",
    "token": "tsx tools/token/token.ts",
    "demo": "tsx tools/demo/demo.ts",
    "contracts": "tsx tools/contracts/generate.ts",
    "contracts:check": "tsx tools/contracts/generate.ts --check",
    "contracts:compat": "tsx tools/contracts/compat.ts",
    "contracts:events": "tsx tools/contracts/check-events.ts",
    "dlq-replay": "tsx tools/dlq-replay/replay.ts",
    "simulate": "tsx tools/simulator/cli.ts",
    "load": "docker run --rm -i -v \"$PWD/tools/load:/load\" -e API_URL=http://host.docker.internal:3000 -e OAUTH_TOKEN_ISSUER=http://host.docker.internal:8081/default grafana/k6 run --summary-export=/load/summary.json /load/scenario.js"
  },
  "dependencies": {
    "@confluentinc/kafka-javascript": "1.11.0",
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/instrumentation-express": "0.73.0",
    "@opentelemetry/instrumentation-http": "0.301.2",
    "@opentelemetry/instrumentation-pg": "0.78.0",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-node": "0.301.2",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "jose": "6.2.18",
    "kysely": "0.29.9",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "swagger-ui-dist": "5.35.1",
    "yaml": "2.9.1",
    "zod": "4.6.7",
    "zod-openapi": "6.0.2"
  },
  "devDependencies": {
    "@asyncapi/parser": "3.6.6",
    "@asyncapi/react-component": "3.2.3",
    "@eslint/js": "10.0.1",
    "@swc/core": "1.16.22",
    "@testcontainers/kafka": "12.2.2",
    "@testcontainers/postgresql": "12.2.2",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.1.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "dependency-cruiser": "18.9.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.11.0",
    "globals": "17.14.0",
    "harnessimo": "^0.14.0",
    "prettier": "3.10.1",
    "supertest": "7.3.2",
    "testcontainers": "12.2.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.1"
  },
  "scarfSettings": {
    "enabled": false
  },
  "allowScripts": {
    "@confluentinc/kafka-javascript@1.11.0": true
  }
}
